# BOTZ website — environment variables
# Copy to .env (local) or set in your hosting dashboard. Never commit real values.

# --- Required -------------------------------------------------------------
# Long random string (32+ bytes). Signs sessions, form tokens and estimate links.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Public address of the site, no trailing slash. Used for canonical URLs, sitemap,
# hreflang, CSRF/CORS and links in notification emails.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Database. Local file (SQLite) or a hosted libSQL/Turso database.
DATABASE_URL=file:./data/botz.db
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Set to "false" to stop development mode from auto-syncing the schema
# (e.g. when running `npm run seed` against a migrated production database).
# PAYLOAD_DB_PUSH=false

# --- Email notifications for new inquiries (optional) ----------------------
# Inquiries are always saved. Without SMTP, the lead shows "Email not configured".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=BOTZ Website

# --- Media storage (optional) -----------------------------------------------
# Without these, uploads are stored in ./media on the server's disk (keep that disk persistent).
# With an S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces…):
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Analytics (optional, off until set) -----------------------------------
# NEXT_PUBLIC_ANALYTICS_PROVIDER = ga4 | plausible | none
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- First administrator (used once by `npm run admin:create`) -------------
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
